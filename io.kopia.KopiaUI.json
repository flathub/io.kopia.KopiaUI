{
    "app-id": "io.kopia.KopiaUI",
    "base": "org.electronjs.Electron2.BaseApp",
    "base-version": "25.08",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "kopia-ui",
    "separate-locales": false,
    "rename-desktop-file": "kopia-ui.desktop",
    "rename-icon": "kopia-ui",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri",
        "--filesystem=host",
        "--filesystem=~/.var/app/",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "modules": [
        {
            "name": "kopia-ui",
            "buildsystem": "simple",
            "build-commands": [
                "ar x kopia-ui_*.deb",
                "tar xf data.tar.xz",
                "cp -r usr/* opt/* /app",
                "chmod -R a-s,go+rX,go-w /app/KopiaUI",
                "sed -i 's|Exec=.*|Exec=kopia-ui %U|' /app/share/applications/kopia-ui.desktop",
                "install kopia-ui.sh /app/bin/kopia-ui",
                "install -Dm644 io.kopia.KopiaUI.appdata.xml /app/share/appdata/io.kopia.KopiaUI.appdata.xml",
                "unzip rclone-v*-linux-*.zip",
                "install rclone-v*-linux-*/rclone /app/bin/rclone"
            ],
            "cleanup": [
                "kopia-ui_*.deb",
                "control.tar.gz",
                "data.tar.xz",
                "debian-binary"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/kopia/kopia/releases/download/v0.23.1/kopia-ui_0.23.1_amd64.deb",
                    "sha256": "678b52a98817b77408f1a992873b9503a6ed44885277c89f04cc00f5eebea3d6",
                    "x-checker-data": {
                        "is-main-source": true,
                        "stable-only": true,
                        "type": "json",
                        "url": "https://api.github.com/repos/kopia/kopia/releases/latest",
                        "tag-query": ".tag_name",
                        "tag-pattern": "^([d.]+)$",
                        "version-query": "$tag | sub(\"^v\"; \"\")",
                        "timestamp-query": ".published_at",
                        "url-query": ".assets[] | select(.name==\"kopia-ui_\" + $version + \"_amd64.deb\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/kopia/kopia/releases/download/v0.23.1/kopia-ui_0.23.1_arm64.deb",
                    "sha256": "56e1a2870f7e424ed432ad5e6f77c001b4e9435a2e505a662c4acfc4035cdd77",
                    "x-checker-data": {
                        "is-main-source": true,
                        "stable-only": true,
                        "type": "json",
                        "url": "https://api.github.com/repos/kopia/kopia/releases/latest",
                        "tag-query": ".tag_name",
                        "tag-pattern": "^([d.]+)$",
                        "version-query": "$tag | sub(\"^v\"; \"\")",
                        "timestamp-query": ".published_at",
                        "url-query": ".assets[] | select(.name==\"kopia-ui_\" + $version + \"_arm64.deb\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "path": "kopia-ui.sh"
                },
                {
                    "type": "file",
                    "path": "io.kopia.KopiaUI.appdata.xml"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/rclone/rclone/releases/download/v1.74.3/rclone-v1.74.3-linux-amd64.zip",
                    "sha256": "dbee7ccd7a5d617e4ed4cd4555c16669b511abfe8d31164f61be35ac9e999bd2",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/rclone/rclone/releases/latest",
                        "tag-query": ".tag_name",
                        "tag-pattern": "^([d.]+)$",
                        "version-query": "$tag | sub(\"^v\"; \"\")",
                        "timestamp-query": ".published_at",
                        "url-query": ".assets[] | select(.name==\"rclone-v\" + $version + \"-linux-amd64.zip\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/rclone/rclone/releases/download/v1.74.3/rclone-v1.74.3-linux-arm64.zip",
                    "sha256": "8f8d47446e061f80c3256659fe8e21f56d72d96aaefe1275d088ea5eb6b42aa7",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/rclone/rclone/releases/latest",
                        "tag-query": ".tag_name",
                        "tag-pattern": "^([d.]+)$",
                        "version-query": "$tag | sub(\"^v\"; \"\")",
                        "timestamp-query": ".published_at",
                        "url-query": ".assets[] | select(.name==\"rclone-v\" + $version + \"-linux-arm64.zip\") | .browser_download_url"
                    }
                }
            ]
        }
    ]
}
